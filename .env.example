# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Get a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# The global host. Regional hosts can stop working if a model's processing region changes.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily, used by the appliance helper to find manuals. https://tavily.com
TAVILY_API_KEY=

# Optional: the distilled Nemotron Nano 4B on a Nebius Serverless AI endpoint (see distill/README.md).
# When unset or unreachable, routing and speech shaping use Nemotron 3.5 Lightning.
FASTLANE_URL=
FASTLANE_TOKEN=
FASTLANE_MODEL=aloud-nano-4b

# Demo guards. In-memory per server instance, so they are best-effort caps.
DAILY_BUDGET_USD=1
SESSION_LIMIT_PER_HOUR=30

# Advanced
# json_schema (default) | json_object | prompt. Falls back automatically if a model rejects json_schema.
NEBIUS_JSON_MODE=json_schema
# Set to false to abstain on every two-frame number disagreement instead of asking Nemotron 3 Ultra.
ENABLE_ADJUDICATION=true
# Model overrides (defaults are in shared/config.ts)
MODEL_VISION=
MODEL_FAST=
MODEL_STEPS=
MODEL_JUDGE=
